rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public product flavors, blogs, and value props read access
    match /flavors/{document} {
      allow read: if true;
      allow write: if true; // Allow admin stock updates
    }
    
    match /blogs/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /valueProps/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customer Orders
    match /orders/{document} {
      allow create: if true; // Guest checkout order placement
      allow read, update: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
